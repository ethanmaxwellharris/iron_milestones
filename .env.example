# Supabase — copy this file to .env.local and fill in your values.
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. Without these the app runs in "Forge Offline" mode
# (all data stored in the browser's localStorage — great for trying it out).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — ONLY for local scripts (npm run seed:achievements,
# npm run arena:warden). It bypasses row level security.
# Never commit it, never expose it to the browser, and never set it on Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
